{
  "name": "zhixu-workbench",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "description": "智序工作台 · 个性化网站导航 + 多模型 AI 助手（BYOK）",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "build": "vite build",
    "build:web": "VITE_DIRECT=1 vite build --base=./ --outDir dist-web",
    "build:single": "vite build --config vite.single.config.ts && node scripts/build-single.mjs",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pack:share": "node scripts/pack-share.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "predeploy:check": "npm run typecheck && npm run scan:secrets"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "cors": "^2.8.6",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "express": "^5.3.0",
    "lucide-react": "^1.57.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
